DJANGO_SETTINGS_MODULE=config.settings.local
DEBUG=True
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_NAME=db.sqlite3
DEFAULT_TIMEZONE=Europe/Madrid
DEFAULT_COUNTRY=ES
OUTREACH_MODE=simulation
EMAIL_PROVIDER=mock
# SMTP is optional: OUTREACH_MODE=live AND EMAIL_PROVIDER=smtp AND workspace opt-in.
# Credentials authorize one server-managed sender; never store them in the database.
OUTREACH_SMTP_HOST=
OUTREACH_SMTP_PORT=587
OUTREACH_SMTP_USERNAME=
OUTREACH_SMTP_PASSWORD=
OUTREACH_SMTP_SENDER=
# starttls (normally 587) or ssl (normally 465); plaintext is rejected.
OUTREACH_SMTP_SECURITY=starttls
OUTREACH_SMTP_TIMEOUT=15
WHATSAPP_PROVIDER=mock
# Cloud API needs live mode, workspace authorization and an approved template.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# Select a supported version explicitly from your Meta application.
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_APP_SECRET=
# Strong random subscription token, at least 32 characters.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_ENABLED=false
WHATSAPP_HTTP_TIMEOUT=15
AI_PROVIDER=mock
PLACES_PROVIDER=mock
# Explicit opt-in: PLACES_PROVIDER=google AND ENABLED=true AND a valid key.
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=
PLACES_CACHE_SECONDS=300
# Website acquisition is independent of messaging and requires both live switches.
WEBSITE_PROVIDER=mock
WEB_CRAWLER_ENABLED=false
WEB_CRAWLER_USER_AGENT=AgencyCRM-Bot/1.0
WEB_CRAWLER_TIMEOUT_SECONDS=10
WEB_CRAWLER_TOTAL_SECONDS=60
WEB_CRAWLER_MAX_BYTES=2000000
WEB_CRAWLER_MAX_PAGES_PER_DOMAIN=8
WEB_CRAWLER_DELAY_SECONDS=1
MAX_EMAILS_PER_DAY=25
MAX_WHATSAPP_PER_DAY=10
CONTACT_COOLDOWN_DAYS=14
# Used only by the future HTTPS deployment settings template.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_PRELOAD=false
